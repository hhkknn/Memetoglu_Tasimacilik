@model SiteContent
@{
    var s = Model.Statement;
    if (!s.Enabled) { return; }
    // Video dosyası diskte yoksa yalnızca arka plan görseli gösterilir.
    var video = s.VideoEnabled ? Yardimci.VideoKaynaklari(s.Video) : null;
}

<section class="statement">
    @if (!string.IsNullOrWhiteSpace(s.Image))
    {
        <div class="bgimg">
            <img src="@Yardimci.Medya(s.Image)" alt="" aria-hidden="true" loading="lazy">
            @if (video is not null)
            {
                <video class="bg-video" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"
                       data-mp4="@video.Mp4" data-webm="@video.Webm"
                       data-mp4-mobil="@video.MobilMp4" data-webm-mobil="@video.MobilWebm"></video>
            }
        </div>
    }
    <div class="wrap">
        <q data-reveal="left">@s.Quote</q>
        <div data-reveal="left" style="transition-delay:140ms">
            @if (!string.IsNullOrWhiteSpace(s.Description)) { <p>@s.Description</p> }
            @if (!string.IsNullOrWhiteSpace(s.ButtonLabel))
            {
                <a class="btn btn-onDeep" href="/iletisim">@s.ButtonLabel</a>
            }
        </div>
    </div>
</section>
