@model SiteContent
@{
    var hero = Model.Hero;
    var wa = Yardimci.WhatsAppUrl(Model.Settings.WhatsApp);
    // Video dosyası diskte yoksa yalnızca poster gösterilir.
    var video = hero.VideoEnabled ? Yardimci.VideoKaynaklari(hero.Video) : null;
}

<section class="hero" id="top">
    <div class="hero-media">
        @* Poster her zaman basılır: video oynayana kadar ve video oynatılamadığında bu görünür. *@
        <img src="@Yardimci.Medya(hero.Poster)" alt="" aria-hidden="true" fetchpriority="high">
        @if (video is not null)
        {
            <video id="hero-video" class="bg-video" muted loop playsinline preload="none"
                   poster="@Yardimci.Medya(hero.Poster)" aria-hidden="true" tabindex="-1"
                   data-mp4="@video.Mp4" data-webm="@video.Webm"
                   data-mp4-mobil="@video.MobilMp4" data-webm-mobil="@video.MobilWebm"></video>
        }
    </div>

    <div class="wrap">
        @if (!string.IsNullOrWhiteSpace(hero.Eyebrow))
        {
            <p class="eyebrow" data-reveal="up">@hero.Eyebrow</p>
        }

        <h1 data-reveal="up" style="transition-delay:80ms">
            @hero.HeadlineTop
            <span class="line2">@hero.HeadlineBottom</span>
        </h1>

        @if (!string.IsNullOrWhiteSpace(hero.Subtitle))
        {
            <p class="hero-sub" data-reveal="up" style="transition-delay:160ms">@hero.Subtitle</p>
        }

        <div class="hero-actions" data-reveal="up" style="transition-delay:240ms">
            <a class="btn btn-primary" href="/iletisim">
                @(string.IsNullOrWhiteSpace(hero.PrimaryButton) ? "Ücretsiz teklif alın" : hero.PrimaryButton)
            </a>
            @if (wa is not null)
            {
                <a class="btn btn-whatsapp" href="@wa" target="_blank" rel="noopener">WhatsApp’tan yazın</a>
            }
            else
            {
                <a class="btn btn-headerGhost" href="/hizmetler">Hizmetleri inceleyin</a>
            }
        </div>

        @if (hero.Highlights.Count > 0)
        {
            <div class="hero-meta" data-reveal="up" style="transition-delay:320ms">
                @foreach (var oge in hero.Highlights)
                {
                    <span>@oge</span>
                }
            </div>
        }
    </div>

    <span class="scroll-cue" aria-hidden="true"></span>
</section>
