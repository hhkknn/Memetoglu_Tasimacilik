@model SiteContent
@{
    var y = Model.Testimonials;
    if (!y.Enabled || y.Items.Count == 0) { return; }
    var yonler = new[] { "left", "up", "right" };
}

<section class="section section-alt" id="yorumlar">
    <div class="wrap">
        <div class="section-head" data-reveal="up">
            @if (!string.IsNullOrWhiteSpace(y.Eyebrow)) { <p class="eyebrow">@y.Eyebrow</p> }
            <h2>@y.Title</h2>
            @if (!string.IsNullOrWhiteSpace(y.Description)) { <p>@y.Description</p> }
            @if (y.NoticeEnabled && !string.IsNullOrWhiteSpace(y.NoticeText))
            {
                <span class="chip">@y.NoticeText</span>
            }

            @if (!string.IsNullOrWhiteSpace(y.GoogleRating))
            {
                <a class="google-chip" href="@(string.IsNullOrWhiteSpace(y.GoogleUrl) ? "#" : y.GoogleUrl)"
                   target="@(string.IsNullOrWhiteSpace(y.GoogleUrl) ? null : "_blank")" rel="noopener">
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                        <path fill="#4285F4" d="M23.52 12.27c0-.85-.08-1.66-.22-2.45H12v4.63h6.47a5.53 5.53 0 0 1-2.4 3.63v3h3.88c2.27-2.09 3.57-5.17 3.57-8.81z"/>
                        <path fill="#34A853" d="M12 24c3.24 0 5.96-1.07 7.95-2.92l-3.88-3c-1.08.72-2.46 1.15-4.07 1.15-3.13 0-5.78-2.11-6.73-4.96H1.27v3.1A12 12 0 0 0 12 24z"/>
                        <path fill="#FBBC05" d="M5.27 14.27a7.2 7.2 0 0 1 0-4.54v-3.1H1.27a12 12 0 0 0 0 10.74z"/>
                        <path fill="#EA4335" d="M12 4.77c1.76 0 3.34.6 4.58 1.79l3.44-3.44C17.95 1.19 15.24 0 12 0A12 12 0 0 0 1.27 6.63l4 3.1C6.22 6.88 8.87 4.77 12 4.77z"/>
                    </svg>
                    <strong>@y.GoogleRating</strong>
                    <span class="stars" aria-hidden="true">★★★★★</span>
                    @if (!string.IsNullOrWhiteSpace(y.GoogleReviewCount))
                    {
                        <span class="muted">(@y.GoogleReviewCount değerlendirme)</span>
                    }
                </a>
            }
        </div>

        <div class="testi-grid">
            @for (var i = 0; i < y.Items.Count; i++)
            {
                var m = y.Items[i];
                var yildiz = Math.Clamp(m.Stars, 1, 5);
                <figure class="testi" data-reveal="@yonler[i % 3]" style="transition-delay:@((i % 3) * 110)ms">
                    <span class="testi-stars" role="img" aria-label="5 üzerinden @yildiz yıldız">@(new string('★', yildiz) + new string('☆', 5 - yildiz))</span>
                    <blockquote>“@m.Quote”</blockquote>
                    <figcaption>
                        <strong>@m.Name</strong>
                        @if (!string.IsNullOrWhiteSpace(m.Role)) { <span>@m.Role</span> }
                    </figcaption>
                </figure>
            }
        </div>
    </div>
</section>
